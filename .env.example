# Copy to .env at the repo root. Never commit .env.

# ---------- Web (exposed to the browser: VITE_* only, nothing secret) ----------
# Referrer-restricted Maps JavaScript API key (localhost + the deployed domain).
VITE_GOOGLE_MAPS_API_KEY=
# /api in dev (Vite proxies it to the API on :8000).
VITE_API_BASE_URL=/api
# live | pipeline | text | scripted
VITE_DEFAULT_MODE=live

# ---------- API (server only, never sent to the browser) ----------
APP_ENV=development
ALLOWED_ORIGIN=http://localhost:5173
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
GEMINI_TEXT_MODEL=
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=
RATE_LIMIT_PER_MIN=20
LIVE_TOKEN_TTL_SECONDS=300
